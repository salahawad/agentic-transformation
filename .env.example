# Run python3 scripts/setup.py to generate a private .env with a random password.
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
PORT=8180
BIND_ADDRESS=127.0.0.1
# Set true when serving behind HTTPS.
COOKIE_SECURE=false

# Required only for compose.https.yaml:
# ATLAS_DOMAIN=atlas.your-company.com
