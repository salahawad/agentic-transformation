# Run python3 scripts/setup.py to generate a private .env with a random password.
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
PORT=8180
BIND_ADDRESS=127.0.0.1
# Set true when serving behind HTTPS.
COOKIE_SECURE=false
# Behind your own reverse proxy (e.g. host nginx -> 127.0.0.1:8180), set this to the app's Docker
# network gateway so sign-in limits apply per visitor: docker network inspect agentic-transformation_default
# FORWARDED_ALLOW_IPS=192.168.224.1

# Required only for compose.https.yaml:
# ATLAS_DOMAIN=atlas.your-company.com
